<div id="<%= dom_id animal %>">
  <div>
    <strong><%= link_to display_name(animal), animal %></strong>
    <% if animal.sex.present? %>
      (<%= animal.sex %>)
    <% end %>
    <% if animal.breed.present? %>
      is a <%= animal.breed %>
    <% end %>
  </div>

  <div>
    <% if animal.age_in_months.present? %>
      <%= animal.name %> is <%= format_age(animal) %>.
    <% end %>
    <% if animal.intake_date.present? %>
      We received <%= animal.name %> on <%= animal.intake_date.to_fs(:long) %>
    <% end %>
  </div>

  <div>
    <strong>Adoption status:</strong>
    <%= status_to_readable(animal) %>
  </div>

  <div>
    <em>(Entry created <%= time_ago_in_words(animal.created_at) %> ago)</em>
  </div>
</div>