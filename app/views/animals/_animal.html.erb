<div id="<%= dom_id animal %>">
  <div>
    <strong>Name:</strong>
    <%= animal.name %>
  </div>

  <div>
    <strong>Species:</strong>
    <%= animal.species %>
  </div>

  <div>
    <strong>Sex:</strong>
    <%= animal.sex %>
  </div>

  <div>
    <strong>Breed:</strong>
    <%= animal.breed %>
  </div>

  <div>
    <strong>Age in months:</strong>
    <%= animal.age_in_months %>
  </div>

  <div>
    <strong>Vaccinated:</strong>
    <%= animal.vaccinated %>
  </div>

  <div>
    <strong>Sterilized:</strong>
    <%= animal.sterilized %>
  </div>

  <div>
    <strong>Intake date:</strong>
    <%= animal.intake_date %>
  </div>

  <div>
    <strong>Adoption status:</strong>
    <%= animal.adoption_status %>
  </div>

  <div>
    <strong>Notes:</strong>
    <%= animal.notes %>
  </div>

</div>
