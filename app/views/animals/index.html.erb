<p style="color: green"><%= notice %></p>

<% content_for :title, "Animals" %>

<h1>Animals</h1>

<% if @animals.present? %>
  <p><%= pluralize(@animals.size, "animal") %> on record.</p>

  <%= link_to "New animal", new_animal_path %>

  <ul id="animals">
    <% @animals.each do |animal| %>
    <li>
      <%= render animal %>
      <p>
        <%= link_to "Show this animal", animal %>
      </p>
    </li>
    <% end %>
  </ul>
<% else %>
  <p>We currently have no animals on record.</p>
  <%= link_to "Add the first animal", new_animal_path %>
<% end %>